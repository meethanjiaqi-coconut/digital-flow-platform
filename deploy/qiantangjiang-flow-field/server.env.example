# 必填：PostgreSQL。启动账号须能创建 flow_field schema 和表。
PG_URL=jdbc:postgresql://<postgres-host>:5432/<database>
PG_USER=<postgres-user>
PG_PASSWORD=<postgres-password>

# 必填：至少 32 位随机字符串。服务端和发布数据的计算机使用同一个值。
FLOW_PUBLISH_TOKEN=<replace-with-random-token>

SERVER_PORT=8793
FLOW_STORAGE_ROOT=/data/flow-field
FLOW_RETAIN_SCENARIOS=100
FLOW_STAGING_HOURS=72
FLOW_CACHE_SCENARIOS=2
FLOW_IO_CORE_THREADS=4
FLOW_IO_MAX_THREADS=8
FLOW_IO_QUEUE_CAPACITY=64
PG_POOL_SIZE=10

# 当前可先关闭；接入钱塘江现有 Nacos 时再填写真实值。
NACOS_ENABLED=false
NACOS_SERVER_ADDR=<nacos-host>:8848
NACOS_NAMESPACE=<namespace-id>
NACOS_GROUP=DEFAULT_GROUP
NACOS_DATA_ID=sgxt-flow-field
NACOS_USERNAME=
NACOS_PASSWORD=
SPRING_PROFILES_ACTIVE=prod

